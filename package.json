{
  "name": "swiftdesk-remote",
  "version": "1.1.0",
  "description": "Ultra-low-latency Cross-Platform Remote Desktop (Windows & macOS) with Cloud ID & WebRTC 60FPS",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc && node scripts/copy-assets.js",
    "start": "npm run build && node scripts/start-app.js",
    "dev": "npm run build && node scripts/start-app.js",
    "mac:loginwindow": "sudo bash scripts/mac-loginwindow.sh install",
    "mac:loginwindow:uninstall": "sudo bash scripts/mac-loginwindow.sh uninstall"
  },
  "keywords": [
    "remote-desktop",
    "webrtc",
    "electron",
    "windows",
    "macos",
    "cloud-id",
    "lan"
  ],
  "author": "SwiftDesk",
  "license": "MIT",
  "dependencies": {
    "koffi": "^2.9.0",
    "mqtt": "^5.15.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.13",
    "electron": "^33.2.0",
    "typescript": "^5.6.3"
  }
}
